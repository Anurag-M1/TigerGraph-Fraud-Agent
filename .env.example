# TigerGraph × Hacker House Goa — Environment Configuration
# Copy this file to .env and fill in your values.

# ── TigerGraph Connection ──
# Savanna Workspace or Community Edition
TIGERGRAPH_HOST=https://your-workspace.i.tgcloud.io
TIGERGRAPH_GRAPHNAME=fraud_graph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your_password
TIGERGRAPH_SECRET=your_secret

# TigerGraph MCP (Model Context Protocol)
# https://github.com/tigergraph/tigergraph-mcp
TIGERGRAPH_MCP_URL=http://localhost:8000

# ── LLM Configuration ──
# The LLM used for classification, synthesis, probability, summary, SAR narrative
LLM_PROVIDER=openai  # or anthropic, google, etc.
LLM_MODEL=gpt-4o
LLM_API_KEY=your_api_key

# ── Data Paths ──
DATA_DIR=./Dataset
CASES_DIR=./cases
